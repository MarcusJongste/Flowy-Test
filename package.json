{
  "name": "flowy-test",
  "version": "1.0.0",
  "description": "A test framework for Node.js and React projects.",
  "keywords": [
    "unittest",
    "test",
    "framework",
    "flowy"
  ],
  "homepage": "https://github.com/MarcusJongste/Flowy-Test#readme",
  "bugs": {
    "url": "https://github.com/MarcusJongste/Flowy-Test/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusJongste/Flowy-Test.git"
  },
  "license": "ISC",
  "author": "Marcus Jongste",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && webpack",
    "build:node": "tsc",
    "build:browser": "webpack",
    "postinstall": "node dist/setup.js",
    "prepare": "npm run build",
    "test:node": "tsx src/test.node.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/webpack-env": "^1.18.8",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "flowy-test": "github:MarcusJongste/Flowy-Test#version/0.1",
    "ts-loader": "^9.5.1",
    "tsx": "^4.7.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
